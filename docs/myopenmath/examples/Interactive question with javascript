$rowitems = diffrandsfrom($rowitempool,4)

// Unique quantity factors.
// Since these are all greater than 1, no row repeats the original quantity.
$qfactors = diffrandsfrom(array(3,4,5,6),4)

// Different-rate cost factors are intentionally outside the same-rate factor set.
// This helps guarantee unique cost values and prevents accidental same-rate rows.
$diffcostfactors = diffrandsfrom(array(2,7,8,9,10,11),4)

for ($i=0..3) {
  $qsf = $qfactors[$i]
  $rowq[$i] = $origq*$qsf

  if ($rowans[$i]==0) {
    $csf = $qsf
    $rowcost[$i] = $origcost*$csf
    $reason[$i] = "The number of items and the total cost were both multiplied by $qsf. Multiplying both quantities by the same factor keeps the unit rate the same."
  } else {
    $csf = $diffcostfactors[$i]
    $rowcost[$i] = $origcost*$csf

    $compareword[$i] = "lower" if ($csf<$qsf)
    $compareword[$i] = "higher" if ($csf>$qsf)

    $reason[$i] = "The number of items was multiplied by $qsf, but the total cost was multiplied by $csf. Since the multipliers are different, the unit rate is different. This creates a {$compareword[$i]} dollars-per-item rate than the original."
  }

  $rowfmt[$i] = rand(0,3)

  $rowtext[$i] = "{$rowq[$i]} {$rowitems[$i]} were sold for &#36;{$rowcost[$i]}." if ($rowfmt[$i]==0)
