// Dynamic drag-and-drop arithmetic sequence formulas
// Question Type: Multipart
// Part 0: recursive previous-term card
// Part 1: recursive signed change
// Part 2: explicit coefficient of n
// Part 3: explicit variable n card
// Part 4: explicit constant

$anstypes = array("number","number","number","number","number")
$answeights = array(1,1,1,1,1)

$rootid = "ddseq".rand(100000,999999)

// Numeric codes for non-numeric formula cards.
$codePrev = 101
$codeN = 102
$codeWrongVar = 103

// Variation types are equally likely:
// 0 = positive first term, positive common difference
// 1 = positive first term, negative common difference
// 2 = negative first term, positive common difference
// 3 = negative first term, negative common difference

$mode = rand(0,3)

$a1mag = rrand(3,18,.1)
$dabs = randfrom(array(.5,.75,1.25,1.5,2,2.5,3,3.5,4,4.5,5,7))

$a1sign = 1
$a1sign = -1 if ($mode==2 || $mode==3)

$dsign = 1
$dsign = -1 if ($mode==1 || $mode==3)

$a1 = $a1sign*$a1mag
$d = $dsign*$dabs

// Generate first five terms.
$t1 = $a1
$t2 = $t1 + $d
$t3 = $t2 + $d
$t4 = $t3 + $d
$t5 = $t4 + $d

// Explicit formula:
// a_n = a_1 + d(n - 1)
// a_n = dn + (a_1 - d)
$b = $a1 - $d

// Answers for hidden MOM answer boxes.
$answer[0] = $codePrev
$answer[1] = $d
$answer[2] = $d
$answer[3] = $codeN
$answer[4] = $b

for ($i=0..4) {
  $answerboxsize[$i] = 6
  $abstolerance[$i] = 0.0001
}

$readerlabel[0] = "Recursive previous term"
$readerlabel[1] = "Recursive signed change"
$readerlabel[2] = "Explicit coefficient"
$readerlabel[3] = "Explicit variable"
$readerlabel[4] = "Explicit constant"

// Display values.
$t1disp = round($t1,2)
$t2disp = round($t2,2)
$t3disp = round($t3,2)
$t4disp = round($t4,2)
$t5disp = round($t5,2)

$ddisp = round($d,2)
$dabsdisp = round(abs($d),2)
$bdisp = round($b,2)
$babsdisp = round(abs($b),2)

$listDisplay = "$t1disp, $t2disp, $t3disp, $t4disp, $t5disp"

// Pretty formula displays.
$recFormulaShow = ""
$recFormulaShow = "a<sub>n</sub> = a<sub>n - 1</sub> + $dabsdisp" if ($d>=0)
$recFormulaShow = "a<sub>n</sub> = a<sub>n - 1</sub> - $dabsdisp" if ($d<0)

$explicitFormulaShow = ""
if ($b>=0) {
  $explicitFormulaShow = "a<sub>n</sub> = $ddisp<span style='font-style:italic;'>n</span> + $babsdisp"
} else {
  $explicitFormulaShow = "a<sub>n</sub> = $ddisp<span style='font-style:italic;'>n</span> - $babsdisp"
}

// Wrong card values.
$numWrong = rand(1,3)

$wrong1 = -$d
$wrong1 = 2*$d if ($wrong1==$d || $wrong1==$b)

$wrong2 = $a1
$wrong2 = $t2 if ($wrong2==$d || $wrong2==$b || $wrong2==$wrong1)
$wrong2 = $a1 + 2*$d if ($wrong2==$d || $wrong2==$b || $wrong2==$wrong1)

$wrong1disp = round($wrong1,2)
$wrong2disp = round($wrong2,2)

// Required cards.
// There are two common-difference cards because the value is used twice.
$cardPrev = "<div role='button' tabindex='0' class='dd-card' draggable='true' data-card-id='prev' data-value='$codePrev'>a<sub>n - 1</sub></div>"
$cardD1 = "<div role='button' tabindex='0' class='dd-card' draggable='true' data-card-id='d1' data-value='$ddisp'>$ddisp</div>"
$cardD2 = "<div role='button' tabindex='0' class='dd-card' draggable='true' data-card-id='d2' data-value='$ddisp'>$ddisp</div>"
$cardN = "<div role='button' tabindex='0' class='dd-card' draggable='true' data-card-id='ncard' data-value='$codeN'><span style='font-style:italic;'>n</span></div>"
$cardB = "<div role='button' tabindex='0' class='dd-card' draggable='true' data-card-id='bcard' data-value='$bdisp'>$bdisp</div>"

$wrongCard1 = "<div role='button' tabindex='0' class='dd-card wrong-card' draggable='true' data-card-id='w1' data-value='$wrong1disp'>$wrong1disp</div>"
$wrongCard2 = "<div role='button' tabindex='0' class='dd-card wrong-card' draggable='true' data-card-id='w2' data-value='$wrong2disp'>$wrong2disp</div>"
$wrongCard3 = "<div role='button' tabindex='0' class='dd-card wrong-card' draggable='true' data-card-id='w3' data-value='$codeWrongVar'>a<sub>1</sub></div>"

$cards = array($cardPrev,$cardD1,$cardD2,$cardN,$cardB)
$cards[5] = $wrongCard1 if ($numWrong>=1)
$cards[6] = $wrongCard2 if ($numWrong>=2)
$cards[7] = $wrongCard3 if ($numWrong>=3)

$shufCards = singleshuffle($cards)

$lastCardIndex = 4 + $numWrong
$cardBankHTML = ""

for ($i=0..$lastCardIndex) {
  $cardBankHTML .= $shufCards[$i]
}

// Feedback.
$prevCorrect = "<div class='dd-feedback dd-correct'><strong>Previous-term card correct.</strong></div>"
$prevWrong = "<div class='dd-feedback dd-wrong'><strong>Check the recursive formula.</strong> The recursive rule should use the term immediately before a<sub>n</sub>.</div>"
$prevFeedback = getfeedbackbasic($prevCorrect,$prevWrong,$thisq,0)

$recCorrect = "<div class='dd-feedback dd-correct'><strong>Recursive change correct.</strong></div>"
$recWrong = "<div class='dd-feedback dd-wrong'><strong>Check the recursive change.</strong> Find the common difference by subtracting consecutive terms: next term minus previous term.</div>"
$recFeedback = getfeedbackbasic($recCorrect,$recWrong,$thisq,1)

$coefCorrect = "<div class='dd-feedback dd-correct'><strong>Coefficient correct.</strong></div>"
$coefWrong = "<div class='dd-feedback dd-wrong'><strong>Check the coefficient.</strong> In an arithmetic sequence, the coefficient of n should match the common difference.</div>"
$coefFeedback = getfeedbackbasic($coefCorrect,$coefWrong,$thisq,2)

$nCorrect = "<div class='dd-feedback dd-correct'><strong>Variable card correct.</strong></div>"
$nWrong = "<div class='dd-feedback dd-wrong'><strong>Check the variable.</strong> The simplified explicit formula should use n as the input term number.</div>"
$nFeedback = getfeedbackbasic($nCorrect,$nWrong,$thisq,3)

$constCorrect = "<div class='dd-feedback dd-correct'><strong>Constant correct.</strong></div>"
$constWrong = "<div class='dd-feedback dd-wrong'><strong>Check the constant.</strong> Substitute n = 1 into your explicit formula. It should give the first term.</div>"
