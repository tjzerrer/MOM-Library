$js = "<script>
(function(){
var root=document.getElementById('$rootid');
if(!root){return;}

var selected=null;
var restoring=true;

function qa(sel){return Array.prototype.slice.call(root.querySelectorAll(sel));}

function inputsFor(i){
  return Array.prototype.slice.call(root.querySelectorAll('.mom-hidden[data-hidden=\"'+i+'\"] input, .mom-hidden[data-hidden=\"'+i+'\"] textarea'));
}

function zoneFor(i){
  return root.querySelector('.dd-drop[data-zone=\"'+i+'\"]');
}

function bank(){
  return root.querySelector('.dd-cardbank[data-zone=\"bank\"]');
}

function setPlaceholders(){
  qa('.dd-drop').forEach(function(z){
    var ph=z.querySelector('.dd-placeholder');
    if(ph){ph.style.display=z.querySelector('.dd-card')?'none':'inline';}
  });
}

function setInput(i,val,send){
  var inputs=inputsFor(i);
  inputs.forEach(function(inp){
    inp.value=val;
    inp.setAttribute('value',val);
    if(send){
      inp.dispatchEvent(new Event('input',{bubbles:true}));
      inp.dispatchEvent(new Event('change',{bubbles:true}));
    }
  });
}

function syncHidden(send){
  for(var i=0;i<5;i++){
    var z=zoneFor(i);
    var c=z?z.querySelector('.dd-card'):null;
    setInput(i,c?c.getAttribute('data-value'):'',send!==false);
  }
}

function clearSelected(){
  qa('.dd-card.selected').forEach(function(c){c.classList.remove('selected');});
  selected=null;
}

function moveCard(card,target,silent){
  if(!card||!target){return;}

  if(target.classList.contains('dd-drop')){
    var old=target.querySelector('.dd-card');
    if(old&&old!==card){bank().appendChild(old);}
    target.appendChild(card);
  } else {
    target.appendChild(card);
  }

  clearSelected();
  setPlaceholders();

  if(!silent && !restoring){
    syncHidden(true);
  }
}

function selectCard(card){
  clearSelected();
  selected=card;
  card.classList.add('selected');
}

function findUnusedCardByValue(val){
  var cards=qa('.dd-card');
  for(var i=0;i<cards.length;i++){
    if(cards[i].getAttribute('data-value')==val && cards[i].getAttribute('data-restored')!='1'){
      return cards[i];
    }
  }
  return null;
}

qa('.dd-card').forEach(function(card){
  card.addEventListener('click',function(ev){
    ev.stopPropagation();
    selectCard(card);
  });

  card.addEventListener('dragstart',function(ev){
    ev.dataTransfer.setData('text/plain',card.getAttribute('data-card-id'));
  });
});

qa('.dd-drop,.dd-cardbank').forEach(function(z){
  z.addEventListener('dragover',function(ev){
    ev.preventDefault();
  });

  z.addEventListener('drop',function(ev){
    ev.preventDefault();
    var id=ev.dataTransfer.getData('text/plain');
    var card=root.querySelector('[data-card-id=\"'+id+'\"]');
    moveCard(card,z,false);
  });

  z.addEventListener('click',function(){
    if(selected){moveCard(selected,z,false);}
  });
});

// Restore saved hidden values after submit.
// Capture all values before moving cards.
var saved=[];
for(var i=0;i<5;i++){
  var inputs=inputsFor(i);
  saved[i]=inputs.length>0 ? String(inputs[0].value).trim() : '';
}

for(var j=0;j<5;j++){
  if(saved[j] !== ''){
    var c=findUnusedCardByValue(saved[j]);
    var z=zoneFor(j);
    if(c&&z){
      c.setAttribute('data-restored','1');
      moveCard(c,z,true);
    }
  }
}

qa('.dd-card').forEach(function(c){c.removeAttribute('data-restored');});

restoring=false;
setPlaceholders();
syncHidden(true);
})();
</script>"

